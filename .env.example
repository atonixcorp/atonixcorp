# Copy this file to .env and replace every placeholder before starting Compose.
POSTGRES_PASSWORD=replace-with-a-local-database-password
JWT_SECRET=replace-with-a-long-random-secret
CONTAINER_SECRET_KEY=replace-with-base64-encoded-32-byte-key
COMPUTE_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
COMPUTE_NODE_TOKEN=replace-with-a-different-random-token-of-at-least-32-characters
AGENT_API_TOKEN=replace-with-a-different-long-random-token
AUTH_COOKIE_SECURE=false
STORAGE_DRIVER=local-file

# Object storage is independent of STORAGE_DRIVER (block storage).
# Use an application-specific, bucket-scoped MinIO identity, never root.
STORAGE_PROVIDER=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=atonixcorp-bucket1
MINIO_USE_SSL=true
# Development only, required to opt into non-TLS MinIO connections.
MINIO_ALLOW_INSECURE_DEVELOPMENT=false
MINIO_REGION=

# The API requires these even when email delivery is not being tested.
# Use an SMTP service reachable from the API container; localhost is the container itself.
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_RECIPIENT=replace-with-recipient@example.com
# Optional recipient for sponsorship notifications.
# SPONSOR_RECIPIENT=replace-with-sponsor-recipient@example.com

# OpenStack access is disabled until credentials are configured. Provisioning
# into the shared project is separately gated by OPENSTACK_ALLOW_SHARED_PROJECT_PROVISIONING.
# Use STORAGE_DRIVER=cinder and set CINDER_VOLUME_TYPE_IDS to enable Cinder storage.
OPENSTACK_AUTH_URL=
OPENSTACK_APPLICATION_CREDENTIAL_ID=
OPENSTACK_APPLICATION_CREDENTIAL_SECRET=
OPENSTACK_SHARED_PROJECT_ID=
OPENSTACK_ALLOW_SHARED_PROJECT_PROVISIONING=false
OPENSTACK_REGION=RegionOne
OPENSTACK_INTERFACE=public
OPENSTACK_ALLOW_INSECURE_HTTP=false
OPENSTACK_ENABLE_NEUTRON=false
CINDER_VOLUME_TYPE_IDS=
CINDER_AVAILABILITY_ZONES=
OPENSTACK_DATABASE_NETWORK_ID=
OPENSTACK_DATABASE_SECURITY_GROUP_ID=
OPENSTACK_DATABASE_FLAVOR_BASIC=
OPENSTACK_DATABASE_FLAVOR_STANDARD=
OPENSTACK_DATABASE_FLAVOR_PREMIUM=
OPENSTACK_DATABASE_IMAGE_POSTGRES_16=
OPENSTACK_DATABASE_IMAGE_POSTGRES_17=
OPENSTACK_DATABASE_IMAGE_MYSQL_8_4=
OPENSTACK_DATABASE_IMAGE_MARIADB_11_4=
OPENSTACK_DATABASE_IMAGE_REDIS_7=

# Separate local secrets for the independently managed HPC and DevTools stacks.
# Generate fresh values with `openssl rand -hex 32`; do not commit a populated
# .env file. The HPC scheduler defaults to disabled until Slurm is configured.
HPC_DB_USER=atonixcorp_hpc
HPC_DB_PASSWORD=replace-with-a-random-database-password
HPC_DB_NAME=atonixcorp_hpc
HPC_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
HPC_S3_ACCESS_KEY=replace-with-a-local-minio-access-key
HPC_S3_SECRET_KEY=replace-with-a-random-minio-secret-key
HPC_S3_BUCKET=atonixcorp-hpc-datasets
HPC_DEFAULT_BACKEND=none
HPC_SLURM_ENABLED=false
# Set HPC_SLURM_ENABLED=true and the executable paths only when the container
# has a Slurm client and can access a configured Slurm controller.
# HPC_SLURM_SBATCH_PATH=/usr/bin/sbatch
# HPC_SLURM_SQUEUE_PATH=/usr/bin/squeue
# HPC_SLURM_SACCT_PATH=/usr/bin/sacct
# HPC_SLURM_SCANCEL_PATH=/usr/bin/scancel
# HPC_SLURM_SCONTROL_PATH=/usr/bin/scontrol
# HPC_CLUSTER_DISCOVERY_INTERVAL=30s
# HPC_CLUSTER_HEALTH_INTERVAL=20s
# HPC_CLUSTER_HEALTH_PORT=22

DEVTOOLS_API_TOKEN=replace-with-a-random-devtools-api-token
DEVTOOLS_PORTAL_TOKEN=replace-with-a-different-random-portal-token

# Isolated DevStack development example only. Set application credential values
# above and verify this is the same Keystone project the credential is scoped to.
# OPENSTACK_AUTH_URL=http://192.168.178.131/identity/v3
# OPENSTACK_SHARED_PROJECT_ID=0a9512b89bf14a8c90cf484c15d53bef
# OPENSTACK_ALLOW_SHARED_PROJECT_PROVISIONING=true
# OPENSTACK_ALLOW_INSECURE_HTTP=true
# OPENSTACK_ENABLE_NEUTRON=true
